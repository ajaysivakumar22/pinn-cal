# Experimental V4: Ignore exploratory models/histories by default, include frozen release checkpoints
experimental/v4/models/*
!experimental/v4/models/pinn_v4_tikhonov015_seed42.pth
!experimental/v4/models/pinn_v4_tikhonov015_seed123.pth
!experimental/v4/models/pinn_v4_tikhonov015_seed456.pth

experimental/v4/histories/*
!experimental/v4/histories/pinn_v4_tikhonov015_seed*.npy

# Allow designated publication figures & frontend assets
!experimental/v4/results/step64_figures/*.png
!experimental/v4/results/step63_figures/*.png
!frontend/src/assets/hero.png
